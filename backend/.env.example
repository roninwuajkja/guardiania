# IA Guardian — configuración del backend
# Copia este archivo como backend/.env y ajusta los valores.
# Pydantic Settings lee las variables en mayúsculas.
#
# Este archivo es una plantilla de DESARROLLO. Para producción usa
# ENVIRONMENT=production y revisa la sección "Producción" al final.

ENVIRONMENT=dev
PUBLIC_BASE_URL=http://127.0.0.1:8000
SEED_DEMO=true

# SQLite es solo para demo local. En producción se exige PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://guardiania:guardiania_dev@localhost:5432/guardiania

# Identidad de los tokens. En dev la llave Ed25519 se genera sola en
# backend/.data/keys/ed25519.pem si no se inyecta JWT_PRIVATE_KEY_PEM.
# En producción JWT_PRIVATE_KEY_PEM es obligatoria (PEM PKCS#8).
JWT_ISSUER=https://api.guardiania.cl
JWT_AUDIENCE=guardiania:api
PAIRING_AUDIENCE=guardiania:pairing
JWT_KID=guardiania-dev-1
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vinculación
PAIRING_TTL_SECONDS=600
PAIRING_CODE_LENGTH=6
PAIRING_MAX_ATTEMPTS=5
WS_TICKET_SECONDS=60

# Peppers: cambia ambos en cualquier entorno que no sea una demo local.
# En producción deben ser aleatorios y de al menos 32 caracteres.
PAIRING_PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio
AUDIT_PEPPER=cambia-esto-tambien-por-un-secreto-largo-y-aleatorio

# Sesiones
ACCESS_TOKEN_MINUTES=30
DEVICE_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TUTOR_REFRESH_DAYS=14
SYNC_MAX_BATCH=200

# Operación
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=*
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=1048576
DOCS_ENABLED=true
REQUIRE_ATTESTATION=false
ACCOUNT_DELETE_PHRASE=ELIMINAR MI CUENTA

# Cookies del panel web. En producción COOKIE_SECURE=true es obligatorio.
# COOKIE_SAMESITE solo acepta lax o strict.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.guardiania.cl

# Retención y versión legal
RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
LEGAL_VERSION=2026-10-22
PRIVACY_EMAIL=privacidad@guardiania.cl
SECURITY_EMAIL=seguridad@guardiania.cl
SUPPORT_EMAIL=soporte@guardiania.cl

# Correo. En dev "console" imprime el correo (incluido el enlace) en el log.
# En producción se exige EMAIL_DELIVERY=smtp o brevo.
# Render Free bloquea SMTP en los puertos 25, 465 y 587: usar brevo.
EMAIL_DELIVERY=console
EMAIL_FROM=IA Guardian <no-reply@guardiania.cl>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Motor de IA (1.2.0)
# ---------------------------------------------------------------------------
# La nube recibe SOLO el vector derivado (categoría, flags, duración, conteos).
# AI_SEND_SNIPPET debe quedar en false: la Regla Cero prohíbe texto en la nube.
AI_ENABLED=true
AI_SEND_SNIPPET=false
# auto = Groq → Gemini → OpenAI → Anthropic, solo con los proveedores que tengan clave.
AI_PROVIDER=auto
AI_PRIMARY_TIMEOUT_MS=1000
AI_FALLBACK_TIMEOUT_MS=450
AI_TOTAL_TIMEOUT_MS=1500
AI_CACHE_TTL_SECONDS=300
AI_CACHE_MAX_ENTRIES=512
AI_BREAKER_FAILURES=3
AI_BREAKER_COOLDOWN_SECONDS=60

# Sin claves el servicio degrada a heurística local; nunca falla la captura.
#
# Groq (free tier). Proveedor primario recomendado para la demo: ~1.000
# req/día y latencia sub-segundo. No entrena con inputs/outputs por defecto.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# low | medium | high. Vacío omite el campo para modelos que no lo aceptan.
GROQ_REASONING_EFFORT=low
#
# Google Gemini (free tier). Solo para demo con vectores sintéticos: la capa
# gratuita puede usar los datos para mejorar el producto. Ver docs/arquitectura-ia.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 0 apaga el razonamiento (menor latencia). Vacío omite thinkingConfig.
GEMINI_THINKING_BUDGET=0
# Para modelos que rechazan thinkingBudget (Flash-Lite): minimal | low | medium | high.
# Si se define, tiene prioridad sobre GEMINI_THINKING_BUDGET.
# GEMINI_THINKING_LEVEL=minimal

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ---------------------------------------------------------------------------
# Notificaciones Firebase Cloud Messaging (HTTP v1)
# ---------------------------------------------------------------------------
# Sin FCM_ENABLED=true y sin la cuenta de servicio, el tutor recibe las alertas
# por WebSocket. FCM es solo transporte: PostgreSQL sigue siendo la verdad.
FCM_ENABLED=false
FCM_TIMEOUT_MS=1500
ANDROID_PACKAGE_NAME=cl.guardiania.agent
# FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json


# ---------------------------------------------------------------------------
# Producción (ejemplo; no copies valores literales)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# PUBLIC_BASE_URL=https://app.guardiania.cl
# DATABASE_URL=postgresql+asyncpg://usuario:clave@db:5432/guardiania
# SEED_DEMO=false
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# PAIRING_PEPPER=<secreto aleatorio de 32+ caracteres>
# AUDIT_PEPPER=<secreto aleatorio de 32+ caracteres>
# COOKIE_SECURE=true
# CORS_ORIGINS=https://app.guardiania.cl
# TRUSTED_HOSTS=app.guardiania.cl
# TRUST_PROXY_HEADERS=true   # solo si el proxy sobrescribe X-Forwarded-For
# DOCS_ENABLED=false
# EMAIL_DELIVERY=smtp
# SMTP_HOST=smtp.guardiania.cl
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# REQUIRE_EMAIL_VERIFICATION=true
#
# IA (opcional; sin claves se usa heurística local)
# AI_ENABLED=true
# AI_SEND_SNIPPET=false   # obligatorio: la Regla Cero no admite texto en la nube
# AI_PROVIDER=auto
# GROQ_API_KEY=<clave del proveedor primario>
# GEMINI_API_KEY=<clave alternativa>
# OPENAI_API_KEY=<clave alternativa>
# ANTHROPIC_API_KEY=<clave de respaldo>
#
# FCM (opcional; requiere la cuenta de servicio en backend/secrets/)
# FCM_ENABLED=true
# FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json
#
# El arranque falla si falta cualquiera de las condiciones anteriores.
# Antes de datos reales, completa la compuerta de lanzamiento:
# docs/compliance/compuerta-lanzamiento.md
